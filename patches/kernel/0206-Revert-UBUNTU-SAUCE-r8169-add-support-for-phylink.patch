-							       MAC_2500FD |
-							       MAC_5000FD |
-							       MAC_10000FD;
-		else if (tp->mac_version == RTL_GIGA_MAC_VER_70)
-			tp->phylink_config.mac_capabilities |= MAC_1000FD |
-							       MAC_2500FD |
-							       MAC_5000FD;
-		else if (tp->mac_version >= RTL_GIGA_MAC_VER_61)
-			tp->phylink_config.mac_capabilities |= MAC_1000FD |
-							       MAC_2500FD;
-		else
-			if (tp->supports_gmii)
-				tp->phylink_config.mac_capabilities |= MAC_1000FD;
-
-		if (tp->mac_version < RTL_GIGA_MAC_VER_61)
